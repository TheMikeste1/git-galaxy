#!/usr/bin/env bash

usage() {
  echo "Usage: git new [OPTIONS] <issue-id>"
  echo '  -h, --help         Display this help message'
  echo '  -f, --force        Force cloning, even if issue does not exist'
  echo '  -i, --independent  Create a fresh clone instead of a worktree'
  exit 1
}

issue_id=
force=false
independent=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    -f|--force)
      force=true
      shift
      ;;
    -i|--independent)
      independent=true
      shift
      ;;
    -*)
      echo "Error: Unknown option $1" >&2
      usage
      ;;
    *)
      issue_id="$1"
      shift
      ;;
  esac
done
readonly issue_id
readonly force
readonly independent

possible_branches_str="$(git branch --format='%(refname:short)' | grep "$issue_id")"
IFS=$'\n' read -rd '' -a possible_branches <<< "$possible_branches_str"
if [[ ${#possible_branches[@]} -gt 1 ]]; then
  echo "Too many branches found for ${issue_id}"
  exit 1
elif [[ ${#possible_branches[@]} -eq 0 ]]; then
  if [[ "$force" == true ]]; then
    possible_branches=(develop )
  else
    # We don't have the branch locally; check on the origin
    possible_branches_str="$(git branch -a --format='%(refname:short)' | grep "$issue_id")"
    IFS=$'\n' read -rd '' -a possible_branches <<< "$possible_branches_str"
    if [[ ${#possible_branches[@]} -gt 1 ]]; then
      echo "Too many branches found for ${issue_id}"
      exit 1
    elif [[ ${#possible_branches[@]} -eq 0 ]]; then
      echo "Cannot find branch for $issue_id"
      exit 1
    fi
  fi
fi

readonly branch="${possible_branches[0]#origin/}"
readonly root_path="$(git worktree list | head -1 | cut -d' ' -f1)"
readonly path="${root_path%/*}/${issue_id}-${root_path##*/}"

if [[ $independent == true ]]; then
  # Clone the repository into an independent directory.
  origin_url=$(git remote get-url origin 2>/dev/null || true)
  if [[ -z ${origin_url} ]]; then
    echo "Failed to determine origin remote URL"
    exit 1
  fi
  if ! git clone --branch "$branch" "$origin_url" "$path"; then
    echo "Failed to clone repository"
    exit 1
  fi
else
  # Create a worktree (default behavior).
  if ! git worktree add "$path" "$branch"; then
    echo "Failed to create new worktree"
    exit 1
  fi
fi

# Copy optional VS Code settings and hook configuration.
if [[ -d "./.vscode" ]]; then
  cp -r "./.vscode" "${path}/"
fi
if [[ -f "./lefthook.yml" ]]; then
  cp "./lefthook.yml" "${path}/"
  if [[ $independent == true ]]; then
    pushd "${path}/" || exit 1
    lefthook install
    popd || exit 1
  fi
fi

git -C "$path" submodule update --init --recursive --jobs="$(nproc)"

if [[ $independent == true ]]; then
  echo "Independent repository for ${issue_id} initialized at ${path}"
else
  echo "New worktree for ${issue_id} initialized at ${path}"
fi
