#!/usr/bin/env bash
set -euo pipefail

script_dir="$(dirname -- "${BASH_SOURCE[0]:-$0}")" && readonly script_dir
readonly lib_root=$script_dir/../lib

script_name="$0" && readonly script_name
usage() {
  echo "Usage: $script_name [OPTIONS] <target branch?>"
  echo '  -h, --help         Display this help message.'
  echo "  --no-fetch         Don't fetch before prepping the PR."
  echo '  <target branch?>   The branch onto which the PR will be made,'
  echo '                     e.g., origin/develop. Defaults to the default'
  echo '                     branch at the origin.'

  exit "$1"
}

fetch=true
onto=
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage 0
      ;;
    --no-fetch)
      fetch=false
      shift 1
      ;;
    -*)
      echo "Error: Unknown option $1" >&2
      usage 1
      ;;
    *)
      if [[ -z "$onto" ]]; then
        onto="$1"
        shift 1
      else
        echo "Already have the target branch!" >&2
        usage 1
      fi
      ;;
  esac
done
readonly fetch

extract_issue_id() {
  "$lib_root/extract_issue_id.sh" "$@"
}

add_id_to_message() {
  local message="$1"

  local id_in_branch
  id_in_branch="$(extract_issue_id "$current_branch")"
  if [[ "$id_in_branch" == "" ]]; then
    echo "$message"
    return 0
  fi

  local origin
  origin="$(git remote get-url origin)"
  readonly origin
  case "$origin" in
    *bitbucket*)
      if [[ "$id_in_branch" == "#"* ]]; then
        id_in_branch="($id_in_branch)"
      fi
      message="$id_in_branch $message"
      ;;
    *)
      message="$message

Closes $id_in_branch"
      ;;
  esac


  echo "$message"
}

current_branch="$(git branch --show-current)" && readonly current_branch
declare -ra BRANCHES_TO_SKIP="${BRANCHES_TO_SKIP:=("master" "main" "develop" "test")}"
for branch in "${BRANCHES_TO_SKIP[@]}"; do
  if [[ "$branch" == "$current_branch" ]]; then
    echo "Branch \`$branch\` is on ignored branches list; not prepping a PR"
    exit 0
  fi
done

if [[ "$fetch" == true ]]; then
  git fetch
fi

if [[ -z "$onto" ]]; then
  onto="$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/@@')"
fi
readonly onto

# As much as I would LOVE to extract this to its own function, `cz` must be ran
# outside of a subshell or it won't display its prompts.
tmp_msg="$(mktemp)"
trap 'rm -f "$tmp_msg"' EXIT
cz commit --dry-run --write-message-to-file "$tmp_msg"
message="$(cat "$tmp_msg")"
message="$(add_id_to_message "$message")"
readonly message

git thwomp "$onto" "$message"
