#!/usr/bin/env python3

import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from string import Template
from typing import Protocol

SCRIPT_DIR = Path(__file__).resolve().parent
GITHOOKS_ROOT = SCRIPT_DIR.parent

YAML_TEMPLATE = Template(
    """---
extends:
$extends_list
"""
)
EXTEND_ITEM_TEMPLATE = Template("  - $extend_item")

class CallableFiletype(Protocol):
    def __call__(self, filepath: Path) -> str:
        pass


@dataclass
class FiletypeMap:
    pattern: dict[str | re.Pattern, str | CallableFiletype]
    filename: dict[str, str | CallableFiletype]
    extension: dict[str, str | CallableFiletype]

    def map(self, file: Path) -> str | None:
        file = file.resolve()
        # Check full path against pattern
        # then against filename
        # finally against extension
        for pattern, filetype in self.pattern.items():
            if isinstance(pattern, re.Pattern):
                if not pattern.match(file):
                    continue
            elif not re.match(pattern, str(file)):
                continue

            if isinstance(filetype, str):
                return filetype
            language = filetype(file)
            return language

        filename = file.name
        for name, filetype in self.filename.items():
            if name != filename:
                continue
            if isinstance(filetype, str):
                return filetype
            language = filetype(file)
            return language

        ext = file.suffix.lstrip(".")
        if not ext:
            return None

        for extension, filetype in self.extension.items():
            if extension != ext:
                continue
            if isinstance(filetype, str):
                return filetype
            language = filetype(file)
            return language
        return ext


def discover_repository_root(starting_from: Path) -> Path:
    result = subprocess.run(
        ["git", "-C", starting_from, "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=True,
    )
    return Path(result.stdout.strip())


def discover_languages(starting_from: Path, filetypes: FiletypeMap) -> set[str]:
    keys_to_compile = []
    for key in filetypes.pattern:
        if isinstance(key, str):
            keys_to_compile.append(key)

    for key in keys_to_compile:
        filetypes.pattern[re.compile(key)] = filetypes.pattern.pop(key)

    ls_files_result = subprocess.run(
        [
            "git",
            "-C",
            starting_from,
            "ls-files",
            "--cached",
            "--others",
            "--deduplicate",
            "-z",
        ],
        capture_output=True,
        text=True,
        check=True,
    )
    languages = set()
    for file in ls_files_result.stdout.split("\0"):
        if not file:
            continue
        language = filetypes.map(Path(file))
        if language:
            languages.add(language)
    return languages


def build_hooks_file(languages: set[str]) -> str:
    lefthook_root = GITHOOKS_ROOT / "lefthook"
    extends = [EXTEND_ITEM_TEMPLATE.substitute(extend_item=lefthook_root / "hooks_common.yml")]

    precommit_root = lefthook_root / "pre-commit"
    precommit_files = {file.stem for file in precommit_root.glob("*.yml")}
    for lang in languages:
        if lang in precommit_files:
            extends.append(
                EXTEND_ITEM_TEMPLATE.substitute(extend_item=precommit_root / f"{lang}.yml"),
            )
    file_contents = YAML_TEMPLATE.substitute(
        extends_list="\n".join(extends),
    )
    return file_contents


def main() -> int:
    """Entry point for the program."""
    repo_root = discover_repository_root(Path.cwd())
    filetypes = FiletypeMap(
        pattern={},
        filename={
            "CMakeLists.txt": "cmake",
        },
        extension={
            "sh": "bash",
            "zsh": "bash",
            "c": "cpp",
            "cc": "cpp",
            "cxx": "cpp",
            "h": "cpp",
            "hh": "cpp",
            "hpp": "cpp",
            "hxx": "cpp",
            "tpp": "cpp",
            "rs": "rust",
            "yml": "yaml",
        },
    )
    languages = discover_languages(repo_root, filetypes)
    print(f"{languages=}")
    file_contents = build_hooks_file(languages)
    with open(repo_root / "lefthook.yml", "w", encoding="utf8") as fout:
        fout.write(file_contents)
    subprocess.run(["lefthook", "install"], cwd=repo_root, check=True)

    return 0


if __name__ == "__main__":
    sys.exit(main())
