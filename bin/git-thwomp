#!/usr/bin/env bash

script_name="$0" && readonly script_name
usage() {
  echo "Usage: $script_name [OPTIONS] [-k | -m <msg>] <onto-commit>"
  echo '  -h, --help         Display this help message'
  echo '  -k, --keep-message Keep the message on the first commit'
  exit "$1"
}

keep_message=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage 0
      ;;
    -m)
      if [[ -z "${commit_msg}" ]]; then
        commit_msg="$2"
      else
        commit_msg="$commit_msg"$'\n\n'"$2"
      fi
      shift 2
      ;;
    -k|--keep-message)
      if [[ -n "${commit_msg}" ]]; then
        echo "Cannot have both $1 and -m" >&2
        usage 2
      fi
      keep_message=true
      shift 1
      ;;
    -*)
      echo "Error: Unknown option $1" >&2
      usage 1
      ;;
    *)
      if [[ -z "${onto}" ]]; then
        onto="$1"
      else
        echo "Error: too many onto commits" >&2
        usage 1
      fi
      shift 1
      ;;
  esac
done
readonly onto
readonly keep_message

if [[ -z "${onto}" ]]; then
  usage 2
fi

set -euo pipefail
thwompee=$(git rev-parse --abbrev-ref HEAD) && readonly thwompee
if git merge-base --is-ancestor "$thwompee" "$onto"; then
  echo "Branch $thwompee is already part of $onto. Nothing to do."
  exit 0
fi

fork_point=$(git merge-base --fork-point "$onto" "$thwompee")
if [[ -z "$fork_point" ]]; then
  # Could not find a normal fork point; $thwompee must not have branched off $onto
  fork_point=$(git merge-base "$onto" "$thwompee")
  if [[ -z "$fork_point" ]]; then
    echo "Could not find fork point between ${thwompee} and ${onto}"
    exit 1
  fi
fi
readonly fork_point

if [[ "$keep_message" == true ]]; then
  first_commit=$(git log --reverse --format=%H "$fork_point..$thwompee" | head -n 1)
  # shellcheck disable=SC2016
  [[ -n "$first_commit" ]] || { echo 'ASSERT FAILED: -n "$first_commit"' 1>&2; exit 1; } # We've already checked that they're not in the same branch, therefore they cannot be the same.
  commit_msg=$(git log -1 --format=%B "$first_commit")
fi
readonly commit_msg

if [[ -z "$commit_msg" ]]; then
  echo "Failed to provide a commit message" >&2
  usage 2
fi

readonly count=$(($(git rev-list --count "$fork_point..$thwompee")))

set +e
git rebase "$onto" # Should allow us to resolve conflicts before squashing
rebase_status=$?
set -e

while [[ "$rebase_status" != 0 ]]; do
  # Check if we are actually in a rebase session
  if [ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ]; then
    echo "⚠️  Rebase paused due to merge conflicts."
    if ! read -rp "Press [Enter] to continue once conflicts are resolved... "; then
      echo "Aborting rebase." >&2
      git rebase --abort
      exit 1
    fi
    set +e
    git rebase --continue
    rebase_status=$?
    set -e
  else
    echo "Git rebase failed due to reasons other than a standard conflict. Aborting." >&2
    git rebase --abort
    exit 1
  fi
done

git switch --quiet "$onto" --detach
cleanup() {
  git switch --quiet "$thwompee"
}
trap cleanup EXIT ERR INT TERM

if ! git merge -n --squash "$thwompee" > /dev/null 2>&1; then
  if ! git merge --abort 2>/dev/null; then
    git reset --hard HEAD
  fi
  echo "Merge conflict detected – merge aborted and changes reverted." >&2
  exit 1
fi
git commit --quiet -nm "$commit_msg"
git branch --quiet -f "$thwompee"
echo "Thwomped ${count} commits from ${thwompee} onto ${onto}."
