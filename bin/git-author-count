#!/usr/bin/env python3
# pylint: disable=invalid-name
import argparse
import subprocess
import sys
from collections import Counter, defaultdict
from concurrent.futures import ThreadPoolExecutor, as_completed


def get_submodule_paths() -> set[str] | None:
    result = subprocess.run(["git", "submodule", "status"], capture_output=True, text=True, check=True)
    if result.returncode != 0:
        return None
    submodules = set()
    for line in result.stdout.splitlines():
        # <indicator>hash path<maybe_space><maybe_other>
        # Skip the indicator and hash
        line = line[len(" ######################################## ") :]
        # path<maybe_space><maybe_other>
        submodule = line
        if line.endswith(")"):  # There's an "other"
            parts = line.split(" ")
            submodule = " ".join(parts[0:-1])
        submodules.add(submodule)

    return submodules


def get_file_authors(file: str) -> Counter[str] | None:
    try:
        result = subprocess.run(
            ["git", "blame", "--line-porcelain", "--", file], capture_output=True, text=True, check=True
        )
    except UnicodeDecodeError:
        # Binary files are not supported
        return None

    if result.returncode != 0:
        return None
    # <commit_hash> 1 1 3
    # author <author>
    # author-mail <<email>>
    # author-time <time>
    # author-tz <tz>
    # committer <commiter>
    # committer-mail <email>
    # committer-time <time>
    # committer-tz <tz>
    # summary <commit message>
    # filename <filename>
    # <code>
    lines = result.stdout.splitlines()
    authors = [line[len("author ") :] for line in lines if line.startswith("author ")]
    counter = Counter(authors)
    return counter


def parse_args():
    parser = argparse.ArgumentParser(description="Count the authors in a git repository")
    parser.add_argument("--all", default=False, action="store_true")
    return parser.parse_args()


def count_blames():
    submodules = get_submodule_paths()
    if submodules is None:
        return 1

    git_files_proc = subprocess.run(["git", "ls-files"], capture_output=True, text=True, check=True)
    if git_files_proc.returncode != 0:
        return 1

    files = [f for f in git_files_proc.stdout.splitlines() if f not in submodules]

    author_counts: Counter[str] = Counter()
    with ThreadPoolExecutor() as executor:
        future_to_file = {executor.submit(get_file_authors, f): f for f in files}
        for future in as_completed(future_to_file):
            counts = future.result()
            if counts:
                author_counts += counts

    for author, count in author_counts.most_common():
        print(author, count)
    return 0


def main() -> int:
    args = parse_args()

    # Ensure we are inside a git repository
    try:
        subprocess.run(["git", "rev-parse", "--is-inside-work-tree"], capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError:
        print("Not a git repository.", file=sys.stderr)
        return 1

    if args.all:
        # TODO: It'd be nice to bias the winners by a recency score of some type.
        # TODO: This takes a while on large repos. Can we stream it?
        output = subprocess.run(
            ["git", "log", "--numstat", "--format='%aN'"], capture_output=True, text=True, check=True
        )
        lines = output.stdout.splitlines()
        author_counts = defaultdict(lambda: [0, 0])
        author = ""
        for line in filter(lambda l: len(l) != 0, lines):
            parts = line.split()
            if len(parts) >= 2:
                additions = parts[0]
                deletions = parts[1]
                # Git will put '-' for binary files
                if additions == "-":
                    additions = 0
                if deletions == "-":
                    deletions = 0

                try:
                    additions = int(additions)
                    deletions = int(deletions)
                except ValueError:  # Must be an author
                    author = line.strip("'")
                    continue
                author_counts[author][0] += additions
                author_counts[author][1] += deletions
            else:
                author = line.strip("'")

        ordered_authors = sorted(author_counts.keys(), key=lambda author: sum(author_counts[author]), reverse=True)
        net_max = 0
        add_max = 0
        sub_max = 0
        author_max = 0
        for author, counts in author_counts.items():
            net_max = max(len(f"{sum(counts)}"), net_max)
            add_max = max(len(f"{counts[0]}"), add_max)
            sub_max = max(len(f"{counts[1]}"), sub_max)
            author_max = max(len(author), author_max)

        index_max = len(f"{len(ordered_authors)}")
        for i, author in enumerate(ordered_authors, 1):
            counts = author_counts[author]
            print(
                f"#{i:<{index_max}}\t{author:<{author_max}}\t+{counts[0]:>{add_max}}\t-{counts[1]:>{sub_max}}\t= {sum(counts):>{net_max}}"
            )

        return 0
    return count_blames()


if __name__ == "__main__":
    sys.exit(main())
